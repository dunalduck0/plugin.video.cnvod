<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="plugin.video.cnvod" name="OleVod" version="0.9.12" provider-name="dunalduck0">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.requests" version="2.22.0" />
        <import addon="inputstream.adaptive" version="2.0.0" optional="true" />
        <import addon="script.module.pycryptodome" version="3.0.0" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Search and play olevod.com, iyf.tv and huavod.com videos. Supports OleVOD VIP for 4K streams.</summary>
        <description lang="en_GB">OleVod: search and stream Chinese on-demand video from olevod.com, iyf.tv, and huavod.com directly on your TV. Supports OleVOD VIP login for 4K streams. No PC, no DevTools, no .strm files.</description>
        <platform>all</platform>
        <language>en zh</language>
        <license>MIT</license>
        <source>https://github.com/dunalduck0/plugin.video.cnvod</source>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
    <addon id="repository.cnvod" name="OleVod Repository" version="1.0.2" provider-name="dunalduck0">
    <requires>
        <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository" name="OleVod Repository">
        <dir minversion="19.0.0">
            <info compressed="false">https://raw.githubusercontent.com/dunalduck0/plugin.video.cnvod/main/docs/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/dunalduck0/plugin.video.cnvod/main/docs/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/dunalduck0/plugin.video.cnvod/main/docs/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">OleVod Repository</summary>
        <description lang="en_GB">Auto-update repository for OleVod (plugin.video.cnvod)</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
