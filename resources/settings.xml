<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="enable_olevod" type="bool" label="Enable olevod.com" default="true"/>
        <setting id="enable_iyftv" type="bool" label="Enable iyf.tv" default="true"/>
        <setting id="enable_huavod" type="bool" label="Enable huavod.com" default="true"/>
        <setting id="search_timeout" type="slider" label="Search timeout (seconds)" default="15" range="5,60" option="int"/>
    </category>
    <category label="OleVOD Account (VIP)">
        <setting id="olevod_username" type="text" label="Username / Email" default=""/>
        <setting id="olevod_password" type="text" label="Password" default="" option="hidden"/>
    </category>
</settings>
